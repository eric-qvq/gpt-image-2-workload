generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProviderType {
  OPENAI_OFFICIAL
  OPENAI_COMPATIBLE
  CUSTOM_HTTP
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  ARCHIVED
  ARCHIVE_FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id           String          @id @default(cuid())
  account      String          @unique
  email        String          @unique
  passwordHash String
  role         Role            @default(MEMBER)
  status       UserStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  conversations Conversation[]
  jobs         GenerationJob[]
}

model Provider {
  id              String          @id @default(cuid())
  name            String
  type            ProviderType
  baseUrl         String
  encryptedApiKey String
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  imageModels     ImageModel[]
  jobs            GenerationJob[]
}

model ImageModel {
  id            String          @id @default(cuid())
  providerId    String
  provider      Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name          String
  defaultParams Json
  capabilities  Json
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  jobs          GenerationJob[]

  @@unique([providerId, name])
}

model Conversation {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  Message[]
  jobs      GenerationJob[]

  @@index([userId])
}

model Message {
  id              String          @id @default(cuid())
  conversationId  String
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String
  generationJobId String?
  generationJob   GenerationJob?  @relation("MessageGeneratedJob", fields: [generationJobId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sourceJobs      GenerationJob[] @relation("JobSourceMessage")
}

model GenerationJob {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId        String?
  message          Message?     @relation("JobSourceMessage", fields: [messageId], references: [id], onDelete: SetNull)
  providerId       String
  provider         Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  modelId          String
  model            ImageModel   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  prompt           String
  requestParams    Json
  upstreamResponse Json?
  status           JobStatus    @default(QUEUED)
  error            String?
  retryCount       Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  imageAssets      ImageAsset[]
  messages         Message[]    @relation("MessageGeneratedJob")

  @@index([status])
  @@index([createdAt])
}

model ImageAsset {
  id          String        @id @default(cuid())
  jobId       String
  job         GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  upstreamUrl String?
  localPath   String?
  fileSize    Int?
  width       Int?
  height      Int?
  mimeType    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([jobId])
}
